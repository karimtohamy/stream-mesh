{
  "info": {
    "name": "Streaming Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8086"
    },
    {
      "key": "user_1_jwt",
      "value": "PASTE_USER_1_JWT_HERE"
    },
    {
      "key": "user_2_jwt",
      "value": "PASTE_USER_2_JWT_HERE"
    },
    {
      "key": "room_code",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{user_1_jwt}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Videos",
      "item": [
        {
          "name": "Get video by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/videos/:id",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "videos", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Get video by slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/videos/slug/:slug",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "videos", "slug", ":slug"],
              "variable": [
                {
                  "key": "slug",
                  "value": "regular-show-s07e04"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Rooms",
      "item": [
        {
          "name": "Create room",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/room/create",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "room", "create"]
            }
          }
        },
        {
          "name": "Join room",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/room/:code/join",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "room", ":code", "join"],
              "variable": [
                {
                  "key": "code",
                  "value": "{{room_code}}"
                }
              ]
            }
          }
        },
        {
          "name": "Leave room",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/room/:code/leave",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "room", ":code", "leave"],
              "variable": [
                {
                  "key": "code",
                  "value": "{{room_code}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "WebSocket Events",
      "item": [
        {
          "name": "Play",
          "request": {
            "method": "GET",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{ \"event\": \"play\", \"data\": { \"position\": 0 } }",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}",
              "host": ["{{base_url}}"]
            },
            "description": "Send via WebSocket connection to ws://localhost:8086/api/v1/room/:code/ws"
          }
        },
        {
          "name": "Pause",
          "request": {
            "method": "GET",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{ \"event\": \"pause\", \"data\": { \"position\": 42.5 } }",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}",
              "host": ["{{base_url}}"]
            },
            "description": "Send via WebSocket connection to ws://localhost:8086/api/v1/room/:code/ws"
          }
        },
        {
          "name": "Seek",
          "request": {
            "method": "GET",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{ \"event\": \"seek\", \"data\": { \"position\": 42.5 } }",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}",
              "host": ["{{base_url}}"]
            },
            "description": "Send via WebSocket connection to ws://localhost:8086/api/v1/room/:code/ws"
          }
        },
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{ \"event\": \"ping\", \"data\": {} }",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}",
              "host": ["{{base_url}}"]
            },
            "description": "Send via WebSocket connection to ws://localhost:8086/api/v1/room/:code/ws — refreshes room TTL without changing state"
          }
        }
      ]
    }
  ]
}
