# Server
MEDIA_SYNC_PORT=8085
TRANSMUX_WORKERS=3

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBIT_EXCHANGE=stream.events
RABBIT_TRANSCODE_QUEUE=media.transcode.events
RABBIT_TRANSCODE_REQ_KEY=media.transcode.request
RABBIT_TRANSCODE_CMP_KEY=media.transcode.completed
RABBIT_USAGE_TICK_KEY=stream.usage.tick

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=stream_admin
MYSQL_PASSWORD=stream_secret

# MinIO / Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secret
MINIO_USE_SSL=false